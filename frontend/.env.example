# Frontend environment variables (Vite)
# Copy to `.env.local` (recommended) or `.env` and adjust as needed.

# Base endpoint used by frontend/src/lib/api/game.ts
VITE_GAME_API_ENDPOINT=http://localhost:3000/api/game

# WebSocket endpoint used by frontend/src/lib/provider/WebSocketProvider.tsx
VITE_WS_ENDPOINT=ws://localhost:3000/ws
